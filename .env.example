# Worldling environment variables (SPEC §13.5).
# Copy to .env.local for local Next.js dev. Never commit real values.

# ---------------------------------------------------------------------------
# Next.js / Vercel
# Validated at build time by src/lib/env.ts (@t3-oss/env-nextjs).
# ---------------------------------------------------------------------------

# Build-only. Production deploy key for Production, preview deploy key for Preview.
# Used by `npx convex deploy --cmd 'pnpm build'`. Not read by app code.
CONVEX_DEPLOY_KEY=

# Convex deployment URL. Locally written by `npx convex dev`; on Vercel set by `convex deploy`.
NEXT_PUBLIC_CONVEX_URL=

# Public site origin, no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Appeal address shown on the suspended screen (optional).
NEXT_PUBLIC_SUPPORT_EMAIL=

# Sentry error tracking (optional until the Sentry phase).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Build-time. "true" serves /dev/** in a production build (Playwright only). Never set on Vercel.
DEV_ROUTES=

# ---------------------------------------------------------------------------
# Convex deployment
# Do NOT put these in .env.local. Set them on each deployment:
#   npx convex env set NAME value            (dev)
#   npx convex env set NAME value --prod     (production)
# Read through convex/lib/env.ts, which throws MISSING_ENV: NAME.
# ---------------------------------------------------------------------------

# development | preview | production | test
# APP_ENV=development

# Site origin used by Convex Auth for redirects.
# SITE_URL=http://localhost:3000

# Generated by the Convex Auth setup (`npx @convex-dev/auth`).
# JWT_PRIVATE_KEY=
# JWKS=

# Google OAuth client.
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# 32 random bytes, base64. Encrypts stored email secrets (§7.6). `openssl rand -base64 32`
# SECRETS_ENCRYPTION_KEY=
# Rotation (§7.6): add SECRETS_ENCRYPTION_KEY_V2 (then _V3...). New writes use the highest version.
# SECRETS_ENCRYPTION_KEY_V2=

# HMAC secret for unsubscribe and export links.
# EMAIL_LINK_SECRET=

# Env fallback email transport (§7.5): smtp | resend
# EMAIL_FALLBACK_TRANSPORT=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM_NAME=Worldling
# EMAIL_FROM_ADDRESS=

# Optional Resend fallback.
# RESEND_API_KEY=

# "true" sends every email through the fake provider (tests, local demos). Never in production.
# EMAIL_FAKE=
