      "use": "Expressive display text and h1 to h3.",
      "reason": "Its distinctive shapes add warmth and curiosity. Large headings give it room to feel crafted without making everyday controls playful.",
      "stack": "\"Bricolage Grotesque\", \"Trebuchet MS\", Arial, sans-serif",
      "woff2": "BricolageGrotesque-variable.woff2"
    },
    "sans": {
      "name": "Geist",
      "source": "Geist-variable.ttf",
      "license": "Geist-OFL.txt",
      "weight_range": [
        100,
        900
      ],
      "axis_ranges": {
        "wght": [
          100,
          900
        ]
      },
      "use": "Body text, h4, buttons, inputs and supporting labels.",
      "reason": "Its restrained shapes keep reading and controls calm. It gives the expressive headings a clear, practical companion.",
      "stack": "\"Geist\", system-ui, -apple-system, \"Segoe UI\", Arial, sans-serif",
      "woff2": "Geist-variable.woff2"
    },
    "mono": {
      "name": "Geist Mono",
      "source": "GeistMono-variable.ttf",
      "license": "GeistMono-OFL.txt",
      "weight_range": [
        100,
        900
      ],
      "axis_ranges": {
        "wght": [
          100,
          900
        ]
      },
      "use": "Bloom levels, standalone counts, timestamps and coordinates.",
      "reason": "Even character widths stabilize changing numbers. Reserving it for data keeps the wider experience warm rather than technical.",
      "stack": "\"Geist Mono\", ui-monospace, \"SFMono-Regular\", Consolas, \"Liberation Mono\", monospace",
      "woff2": "GeistMono-variable.woff2"
    }
  },
