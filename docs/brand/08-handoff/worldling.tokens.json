        "name": "World focus",
        "duration_ms": 600,
        "easing": "cubic-bezier(0.45, 0, 0.55, 1)",
        "change": "Camera shift at most 8% of viewport. No roll.",
        "reduced": "150ms crossfade between stationary views."
      },
      "comet": {
        "name": "Comet arrival",
        "duration_ms": 900,
        "easing": "cubic-bezier(0.22, 0.61, 0.36, 1)",
