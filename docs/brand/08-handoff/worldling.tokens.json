  "usage": {
    "colorRoles": {
      "void": "Main canvas; ink on bright filled controls.",
      "surface": "Panels, cards, navigation and status containers.",
      "surface-raised": "Raised panels, menus and nested surfaces.",
      "text": "Headings, body copy and primary icons on dark.",
      "text-muted": "Secondary copy, metadata and supporting labels.",
      "primary": "Primary brand, selected controls and secondary actions.",
      "accent": "Growth details, bloom accents and focus color on dark.",
      "warm": "Main call to action: create a world or send a comet.",
      "link": "Default link and selected-text color on dark surfaces.",
      "line": "Decorative separators only, never a required control boundary.",
      "control-line": "Visible input and control boundaries on dark surfaces.",
      "success": "Saved, delivered, completed or a healthy system state.",
      "success-surface": "Opaque success message background; precomposed 12% color over Deep Space.",
      "warning": "Needs attention; a recoverable limit or unsaved change.",
      "warning-surface": "Opaque warning message background; precomposed 12% color over Deep Space.",
      "danger": "Failed action, destructive action or an error that needs repair.",
      "danger-surface": "Opaque danger message background; precomposed 12% color over Deep Space.",
      "info": "Neutral guidance, updates and helpful status information.",
      "info-surface": "Opaque info message background; precomposed 12% color over Deep Space.",
      "glass": "Translucent background only. Keep foreground text opaque.",
      "glass-control-line": "Functional boundaries inside glass panels.",
      "on-primary": "Label on Nebula 500 or 400. Do not assume it works on every shade.",
      "on-accent": "Label on Aurora 500.",
      "on-warm": "Label on Sunrise 500, 400 or 600."
    },
    "ratios": {
      "dark_surfaces_percent": 70,
      "neutral_text_and_icons_percent": 20,
      "brand_accents_percent": 10,
      "detail": {
        "Void": 50,
        "Deep Space": 15,
        "Orbit": 5,
        "Starlight": 15,
        "Dust": 5,
        "Nebula": 5,
        "Aurora": 3,
        "Sunrise": 2
      },
      "interpretation": "A visual-emphasis guide for branded UI, not a literal pixel quota. Planet artwork can have its own world-specific colors. Status colors appear only when needed."
    },
    "durationAliases": {
      "fast": "Hover and focus color feedback",
      "base": "Panel entrance",
      "slow": "World focus or camera movement; not a default button transition"
    },
    "rules": {
      "capitalization": "Sentence case for headings and controls; lowercase is reserved for the supplied logo wordmark.",
      "display_width_percent": 100,
      "optical_sizing": "auto in browsers; do not condense headings to force a fit.",
      "paragraph_measure": "50 to 65ch on wide layouts; let mobile copy use the available width.",
      "display_measure": "About 12 to 16ch; allow natural wrapping.",
      "title_wrapping": "Allow long world names to wrap, including unbroken user text.",
      "body_numbers": "Keep numbers inside normal sentences in Geist; use Geist Mono for separate data.",
      "caption_limit": "Do not use captions for main instructions, errors or actions.",
      "logo": "Use the approved Step 2 outlined logo. Do not rebuild the wordmark with a live text style.",
      "locale": "Use the Step 7 English and French copy files.",
      "scope": "Type specification and specimen checks, not full application accessibility certification."
    }
  }
