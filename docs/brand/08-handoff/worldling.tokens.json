        "name": "Ambient drift",
        "duration_ms": 16000,
        "easing": "cubic-bezier(0.45, 0, 0.55, 1)",
        "change": "Full cycle: 0px to -4px to 0px. One featured world.",
        "reduced": "Static position; no ambient animation."
      },
